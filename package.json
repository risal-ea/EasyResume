{
  "name": "easyresume",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP server and web UI for tailoring ATS-friendly resumes with Claude and Codex.",
  "type": "module",
  "bin": {
    "easyresume": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 4747 -H 127.0.0.1",
    "dev:mcp": "tsx src/cli.ts mcp --no-web",
    "build": "next build && node scripts/build-cli.mjs",
    "start": "node dist/cli.js web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "docx": "^9.15.0",
    "next": "^16.4.3",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.2",
    "pdf-parse": "^2.4.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
